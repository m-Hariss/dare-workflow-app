# Copy this file to ".env" and fill in YOUR OWN values.
# Never commit or share the real .env (it is gitignored).
#
# These are fallback credentials read by the app at startup.
# The preferred way to set keys is via the dashboard UI —
# they are stored encrypted in the SyftBox app data directory.

# LLM provider keys — only the ones your workflows use are required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: only if a workflow uses a local Ollama model.
# OLLAMA_HOST=http://localhost:11434

# Optional: override the local HTTP port (default 8081).
# RUNNER_PORT=8081
