# Copy this file to ".env" and fill in YOUR OWN values.
# Never commit or share the real .env (it is gitignored).

# Dare backend base URL (where the workflow export + data APIs live)
DARE_BASE_URL=http://localhost:8000

# A fresh Dare access token (from the Dare login endpoint). No "Bearer" prefix.
# Tokens expire ~12h; grab a new one when it stops working.
DARE_TOKEN=

# LLM provider keys — only the ones your workflows actually use are required.
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=

# Optional: only if a workflow uses a local Ollama model
# OLLAMA_HOST=http://localhost:11434

# Optional: override the local HTTP port (defaults to 8081)
# RUNNER_PORT=8081
